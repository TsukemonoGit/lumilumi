{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/types",
      "./src/types.ts"
    ],
    "lib": [
      "ESNext",
      "DOM",
      "WebWorker"
    ]
  },
  "exclude": [
    "src/service-worker"
  ],
  "include": [
    "src",
    "vite.config.ts"
  ]
}
