{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumilumi",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat_v2"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "previews": {}
}
